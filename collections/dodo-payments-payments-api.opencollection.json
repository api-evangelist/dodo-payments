{
  "opencollection": "1.0.0",
  "info": {
    "name": "Dodo Checkout Sessions Payments API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Payments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List payments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://live.dodopayments.com/payments",
            "params": [
              {
                "name": "page_number",
                "value": "",
                "type": "query"
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query"
              },
              {
                "name": "customer_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "status",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List payments"
        },
        {
          "info": {
            "name": "Create a one-time payment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://live.dodopayments.com/payments",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a one-time payment"
        },
        {
          "info": {
            "name": "Get a payment",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://live.dodopayments.com/payments/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a payment"
        },
        {
          "info": {
            "name": "Get the invoice for a payment",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://live.dodopayments.com/payments/:id/invoice",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get the invoice for a payment"
        },
        {
          "info": {
            "name": "Retrieve payment line items",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://live.dodopayments.com/payments/:id/line-items",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve payment line items"
        }
      ]
    }
  ],
  "bundled": true
}